# LangGoap — environment variable template
# Copy this file to .env and fill in your real keys.
# .env is gitignored and must never be committed.

# ── LLM API Keys ─────────────────────────────────────────────────────────────
# Required only for tests marked @pytest.mark.api (real LLM integration tests).
# Run them with:  uv run pytest -m api
# Skip them with: uv run pytest -m "not api"  (default CI behaviour)

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
